{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently --kill-others -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch --env-file=.env apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && node scripts/build-workflows.mjs",
    "start": "tsx --env-file=.env apps/api/src/server.ts",
    "db:migrate": "tsx --env-file=.env packages/storage/src/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write apps packages scripts tests infra .github package.json tsconfig.json playwright.config.ts docker-compose.yml .prettierrc.json",
    "worker": "tsx --env-file=.env apps/workflow-worker/main.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "fastify": "5.12.5",
    "lucide-react": "1.54.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
