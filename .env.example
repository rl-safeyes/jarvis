DATABASE_URL=postgresql://jarvis:replace-me@127.0.0.1:55432/jarvis
POSTGRES_PASSWORD=replace-me
JARVIS_OWNER_PASSWORD=replace-with-at-least-20-random-characters
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3000
HARNESS_MODE=live
# Generated by npm run setup; never put real credentials in this example.
JARVIS_SUPERVISOR_TOKEN=
JARVIS_VAULT_KEY=
JARVIS_INITIAL_HARNESSES=codex,claude-code

# STT auto-hébergé. Compose configure WHISPER_URL=http://whisper:8000.
# Pour npm run dev : démarrer le moteur via infra/voice.dev.yml (README).
WHISPER_URL=http://127.0.0.1:8000
STT_MODEL=Systran/faster-whisper-small
